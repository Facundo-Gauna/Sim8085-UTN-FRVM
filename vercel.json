{
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @sim8085/web",
  "outputDirectory": "packages/web/dist",
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
