{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sim8085",
  "version": "0.3.0",
  "identifier": "ar.edu.utn.sim8085",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @sim8085/web",
    "beforeBuildCommand": "npm run build -w @sim8085/web"
  },
  "app": {
    "windows": [
      {
        "title": "Sim8085",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Simulador educativo del Intel 8085",
    "longDescription": "Simulador del microprocesador Intel 8085 para Arquitectura de Computadoras (UTN Villa María): editor, ensamblador, ejecución paso a paso, ejercicios y hojas de entrega en PDF.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
